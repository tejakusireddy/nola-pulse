{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "trend",
  "position": {
    "x": 25,
    "y": 265,
    "width": 720,
    "height": 430,
    "z": 290,
    "tabOrder": 290
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Attendance"
                    }
                  },
                  "Property": "game_number"
                }
              },
              "queryRef": "Attendance.game_number",
              "nativeQueryRef": "game_number"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Attendance"
                    }
                  },
                  "Property": "Reported Attendance"
                }
              },
              "queryRef": "Attendance.Reported Attendance",
              "nativeQueryRef": "Reported Attendance"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Reported attendance by completed home-game number'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
